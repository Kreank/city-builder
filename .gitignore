# Unity
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
crashlytics-build.properties

# Asset-Store-Pakete (Lizenz: nicht weitergeben; Liste in CLAUDE.md, neu importieren über "My Assets")
/Assets/ThirdParty/
/Assets/ThirdParty.meta

# Unter Assets/ wird NUR Eigenes versioniert. Store-Pakete landen beim Import über den Package Manager
# zunächst direkt unter Assets/ – so können sie nie versehentlich ins öffentliche Repo.
# Eigene Assets (auch Blender-Modelle) gehören nach Assets/_Project/.
/Assets/*
!/Assets/_Project/
!/Assets/_Project.meta
!/Assets/Scenes/
!/Assets/Scenes.meta
!/Assets/Settings/
!/Assets/Settings.meta
!/Assets/InputSystem_Actions.inputactions
!/Assets/InputSystem_Actions.inputactions.meta

# Blender: nur Skripte versionieren (Modelle entstehen reproduzierbar über blender/run.ps1 bzw. run_all.ps1);
# .blend-Arbeitsdateien und Renders sind groß und jederzeit neu erzeugbar.
/blender/blend/
/blender/renders/
*.blend1
__pycache__/
*.pyc

# Von Unity generierte IDE-Dateien
.vs/
.idea/
*.csproj
!Tests/**/*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs

# dotnet Tests
Tests/**/bin/
Tests/**/obj/

# OS
.DS_Store
Thumbs.db
