/* =====================================================================================================
   City Builder – Spiel-UI (UI Toolkit). Stil laut abgenommenem Entwurf: dunkel, sachlich, leicht warm.
   Referenzauflösung 1920×1080 (PanelSettings: ScaleWithScreenSize), alle Maße in Referenz-Pixeln.
   Nur Eigenschaften, die UI Toolkit (Unity 6) kennt: kein box-shadow, kein gap, kein grid –
   Abstände über margin, Raster über flex-wrap.

   SCHRIFT: Geplant sind Manrope (Überschriften) und Inter (Text/Zahlen). Solange die Schriften nicht im
   Projekt liegen, gilt die Unity-Standardschrift aus dem Theme. Zum Tauschen nur die beiden Regeln
   .cb-root (Text) und .cb-heading (Überschriften) unten um -unity-font-definition ergänzen, z. B.
     -unity-font-definition: url("project://database/Assets/_Project/UI/Fonts/Inter SDF.asset");
   ===================================================================================================== */

:root {
    /* Flächen */
    --cb-panel: rgba(26, 28, 34, 0.94);
    --cb-panel-strong: rgba(26, 28, 34, 0.97);
    --cb-surface: #1C1E24;
    --cb-surface-2: #14161B;
    --cb-card: #262932;
    --cb-card-hover: #2E323C;
    --cb-border: #343846;
    --cb-border-soft: #303440;

    /* Text */
    --cb-text: #ECE9E4;
    --cb-text-muted: #A9A5B0;
    --cb-text-secondary: #C9C5CE;

    /* Akzente */
    --cb-action: #2BB3A3;
    --cb-action-hover: #5FD3C5;
    --cb-on-action: #10201E;
    --cb-accent: #F2A93B;
    --cb-on-accent: #1C1E24;
    --cb-warn: #F08A4B;
    --cb-warn-text: #F5A06A;
    --cb-warn-surface: #3A2A1E;
    --cb-warn-border: #6B4426;
    --cb-ok-surface: #1F3324;
    --cb-ok-text: #8FD694;

    /* Zonen */
    --cb-zone-residential: #5DBB63;
    --cb-zone-commercial: #4A90D9;
    --cb-zone-industry: #E0A030;
    --cb-zone-office: #8C6BD1;

    /* Radien */
    --cb-radius-panel: 12px;
    --cb-radius-card: 10px;
    --cb-radius-button: 8px;

    /* Schriftgrößen */
    --cb-font-xs: 11px;
    --cb-font-s: 12px;
    --cb-font-m: 13px;
    --cb-font-l: 15px;
}

/* ------------------------------------------------------------ Grundlagen */

.cb-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: var(--cb-text);
    font-size: var(--cb-font-m);
    /* -unity-font-definition: Inter (s. Kopf) */
}

.cb-heading {
    -unity-font-style: bold;
    /* -unity-font-definition: Manrope (s. Kopf) */
}

.cb-root Label {
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.cb-panel {
    background-color: var(--cb-panel);
    border-width: 1px;
    border-color: var(--cb-border);
    border-radius: var(--cb-radius-panel);
}

.cb-row {
    flex-direction: row;
    align-items: center;
}

.cb-col {
    flex-direction: column;
}

.cb-spacer {
    flex-grow: 1;
}

.cb-muted {
    color: var(--cb-text-muted);
}

.cb-secondary {
    color: var(--cb-text-secondary);
}

.cb-text-ok {
    color: var(--cb-action);
}

.cb-text-warn {
    color: var(--cb-warn-text);
}

.cb-bold {
    -unity-font-style: bold;
}

.cb-separator {
    width: 1px;
    height: 28px;
    background-color: var(--cb-border);
    margin-left: 8px;
    margin-right: 8px;
}

.cb-hidden {
    display: none;
}

/* ------------------------------------------------------------ Icons (gezeichnet per Painter2D, Farbe = color) */

.cb-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
}

.cb-icon--l {
    width: 22px;
    height: 22px;
}

.cb-icon--s {
    width: 14px;
    height: 14px;
}

/* ------------------------------------------------------------ Knöpfe */

.cb-btn {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 32px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: var(--cb-radius-button);
    border-width: 1px;
    border-color: var(--cb-border);
    background-color: var(--cb-card);
    color: var(--cb-text);
    margin-left: 3px;
    margin-right: 3px;
    -unity-font-style: bold;
    font-size: var(--cb-font-s);
    transition-property: background-color, border-color, color;
    transition-duration: 0.12s;
}

.cb-btn:hover {
    background-color: var(--cb-card-hover);
}

.cb-btn:active {
    background-color: var(--cb-surface-2);
}

.cb-btn.cb-on {
    border-color: var(--cb-action);
    color: var(--cb-action);
}

.cb-btn--primary {
    background-color: var(--cb-action);
    border-color: var(--cb-action);
    color: var(--cb-on-action);
}

.cb-btn--primary:hover {
    background-color: var(--cb-action-hover);
}

.cb-btn--square {
    width: 32px;
    padding-left: 0;
    padding-right: 0;
}

.cb-btn > .cb-icon {
    margin-right: 6px;
}

.cb-btn--square > .cb-icon {
    margin-right: 0;
}

/* Segment (z. B. Spieltempo, Werkzeugmodus): Spur + Knöpfe */
.cb-segment {
    flex-direction: row;
    align-items: center;
    background-color: var(--cb-surface-2);
    border-radius: var(--cb-radius-button);
    padding-left: 2px;
    padding-right: 2px;
    padding-top: 3px;
    padding-bottom: 3px;
    margin-left: 3px;
    margin-right: 3px;
}

.cb-seg-btn {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 30px;
    padding-left: 11px;
    padding-right: 11px;
    margin-left: 2px;
    margin-right: 2px;
    border-radius: 6px;
    color: var(--cb-text-muted);
    -unity-font-style: bold;
    font-size: var(--cb-font-s);
    transition-property: background-color, color;
    transition-duration: 0.12s;
}

.cb-seg-btn:hover {
    color: var(--cb-text);
}

.cb-seg-btn.cb-on {
    background-color: var(--cb-card);
    color: var(--cb-action);
}

.cb-seg-btn--icon {
    width: 38px;
    padding-left: 0;
    padding-right: 0;
}

/* ------------------------------------------------------------ Obere Leiste */

.cb-topbar {
    position: absolute;
    left: 16px;
    right: 16px;
    top: 14px;
    height: 60px;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
}

.cb-brand {
    flex-direction: row;
    align-items: center;
    margin-right: 14px;
}

.cb-logo {
    width: 38px;
    height: 38px;
    border-radius: var(--cb-radius-button);
    background-color: var(--cb-action);
    color: var(--cb-surface);
    align-items: center;
    justify-content: center;
    margin-right: 10px;
}

.cb-city-name {
    font-size: 19px;
}

.cb-date {
    font-size: var(--cb-font-s);
    color: var(--cb-text-muted);
}

.cb-stat {
    flex-direction: row;
    align-items: center;
    height: 42px;
    padding-left: 14px;
    padding-right: 14px;
    margin-left: 4px;
    margin-right: 4px;
    border-radius: var(--cb-radius-button);
    background-color: var(--cb-card);
    border-width: 1px;
    border-color: var(--cb-border);
}

.cb-stat > .cb-icon {
    margin-right: 8px;
}

.cb-stat__label {
    font-size: var(--cb-font-xs);
    color: var(--cb-text-muted);
}

.cb-stat__value {
    font-size: var(--cb-font-l);
    -unity-font-style: bold;
}

/* Konto überzogen / Baustopp */
.cb-stat__value--warn {
    color: var(--cb-warn-text);
}

.cb-stat__extra {
    font-size: var(--cb-font-s);
    color: var(--cb-text-muted);
    margin-left: 6px;
    -unity-font-style: normal;
}

.cb-icon--action {
    color: var(--cb-action);
}

.cb-icon--accent {
    color: var(--cb-accent);
}

.cb-chip-warn {
    flex-direction: row;
    align-items: center;
    height: 42px;
    padding-left: 12px;
    padding-right: 12px;
    margin-left: 4px;
    margin-right: 4px;
    border-radius: var(--cb-radius-button);
    background-color: var(--cb-warn-surface);
    border-width: 1px;
    border-color: var(--cb-warn-border);
    color: var(--cb-warn);
}

.cb-chip-warn:hover {
    border-color: var(--cb-warn);
}

.cb-chip-warn > .cb-icon {
    margin-right: 6px;
}

.cb-chip-warn__text {
    -unity-font-style: bold;
    font-size: var(--cb-font-m);
    color: var(--cb-warn-text);
}

.cb-icon-btn {
    width: 42px;
    height: 42px;
    margin-left: 6px;
    border-radius: var(--cb-radius-button);
    border-width: 1px;
    border-color: var(--cb-border);
    background-color: var(--cb-card);
    color: var(--cb-text);
    align-items: center;
    justify-content: center;
    transition-property: background-color, color;
    transition-duration: 0.12s;
}

.cb-icon-btn:hover {
    background-color: var(--cb-card-hover);
}

.cb-icon-btn.cb-on {
    background-color: var(--cb-accent);
    border-color: var(--cb-accent);
    color: var(--cb-on-accent);
}

/* ------------------------------------------------------------ Linke Ansichtsleiste */

.cb-rail {
    position: absolute;
    left: 16px;
    top: 92px;
    width: 56px;
    padding-top: 5px;
    padding-bottom: 5px;
    align-items: center;
}

.cb-rail-btn {
    width: 44px;
    height: 44px;
    margin-top: 3px;
    margin-bottom: 3px;
    border-radius: var(--cb-radius-button);
    align-items: center;
    justify-content: center;
    color: var(--cb-text-secondary);
    transition-property: background-color, color;
    transition-duration: 0.12s;
}

.cb-rail-btn:hover {
    background-color: var(--cb-card);
}

.cb-rail-btn.cb-on {
    background-color: var(--cb-accent);
    color: var(--cb-on-accent);
}

.cb-rail-sep {
    width: 32px;
    height: 1px;
    margin-top: 4px;
    margin-bottom: 4px;
    background-color: var(--cb-border);
}

.cb-overlay-name {
    position: absolute;
    left: 84px;
    top: 92px;
    height: 36px;
    flex-direction: row;
    align-items: center;
    padding-left: 14px;
    padding-right: 14px;
    background-color: var(--cb-panel);
    border-width: 1px;
    border-color: var(--cb-border);
    border-radius: var(--cb-radius-button);
}

.cb-overlay-name__label {
    font-size: var(--cb-font-s);
    color: var(--cb-text-muted);
    margin-right: 8px;
}

.cb-overlay-name__value {
    font-size: 14px;
}

/* ------------------------------------------------------------ Bauleiste unten */

.cb-buildbar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 16px;
    align-items: center;
}

.cb-hint {
    flex-direction: row;
    align-items: center;
    max-width: 1100px;
    min-height: 32px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 6px;
    padding-bottom: 6px;
    margin-bottom: 8px;
    background-color: var(--cb-panel);
    border-width: 1px;
    border-color: var(--cb-border);
    border-radius: var(--cb-radius-button);
}

.cb-hint > .cb-icon {
    margin-right: 8px;
    color: var(--cb-action);
}

.cb-hint__text {
    font-size: var(--cb-font-m);
    white-space: normal;
    flex-shrink: 1;
}

.cb-hint--error {
    background-color: var(--cb-warn-surface);
    border-color: var(--cb-warn-border);
}

.cb-hint--error > .cb-icon {
    color: var(--cb-warn);
}

.cb-hint--error > .cb-hint__text {
    color: var(--cb-warn-text);
    -unity-font-style: bold;
}

.cb-build-panel {
    width: 1040px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    margin-bottom: 8px;
    background-color: var(--cb-panel-strong);
}

.cb-build-panel__header {
    flex-direction: row;
    align-items: center;
    padding-left: 4px;
    padding-right: 4px;
    margin-bottom: 8px;
}

.cb-build-panel__title {
    font-size: var(--cb-font-l);
}

.cb-build-panel__hint {
    font-size: var(--cb-font-s);
    color: var(--cb-text-muted);
}

.cb-tool-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.cb-option-label {
    font-size: var(--cb-font-s);
    color: var(--cb-text-muted);
    margin-left: 6px;
    margin-right: 4px;
}

.cb-option-value {
    font-size: var(--cb-font-m);
    -unity-font-style: bold;
    min-width: 54px;
    -unity-text-align: middle-center;
}

.cb-tiles {
    flex-direction: row;
    flex-wrap: wrap;
}

.cb-tile {
    width: 118px;
    height: 100px;
    margin-left: 4px;
    margin-right: 4px;
    margin-top: 4px;
    margin-bottom: 4px;
    padding-top: 8px;
    padding-bottom: 6px;
    padding-left: 4px;
    padding-right: 4px;
    align-items: center;
    border-radius: var(--cb-radius-card);
    border-width: 2px;
    border-color: var(--cb-border-soft);
    background-color: var(--cb-card);
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.cb-tile:hover {
    background-color: var(--cb-card-hover);
}

.cb-tile.cb-on {
    border-color: var(--cb-action);
}

.cb-tile__swatch {
    width: 52px;
    height: 36px;
    border-radius: var(--cb-radius-card);
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.92);
    margin-bottom: 6px;
}

.cb-tile__name {
    font-size: var(--cb-font-s);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.cb-tile__sub {
    font-size: var(--cb-font-xs);
    color: var(--cb-text-muted);
    -unity-text-align: middle-center;
    margin-top: 2px;
}

.cb-tile-sep {
    width: 1px;
    height: 84px;
    margin-left: 6px;
    margin-right: 6px;
    margin-top: 12px;
    background-color: var(--cb-border);
}

/* Kachel mit Vorschaubild (Bauleiste aufgeräumt): Bild des 3D-Modells bzw. schlichtes Icon in der Gruppenfarbe,
   darunter Name + eine Unterzeile (Kosten); Details im Tooltip */
.cb-tile--thumb {
    width: 104px;
    height: 124px;
    padding-top: 6px;
    padding-bottom: 6px;
}

.cb-tile__thumb {
    width: 88px;
    height: 64px;
    margin-bottom: 5px;
    border-radius: var(--cb-radius-button);
    border-bottom-width: 2px;
    border-bottom-color: var(--cb-border);
    background-color: var(--cb-surface-2);
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
}

.cb-tile--thumb:hover .cb-tile__thumb {
    background-color: var(--cb-surface);
}

.cb-tile--thumb.cb-on .cb-tile__thumb {
    background-color: rgba(43, 179, 163, 0.16);
}

.cb-tile__thumb-icon {
    width: 28px;
    height: 28px;
    opacity: 0.85;
}

.cb-tile__thumb-image {
    position: absolute;
    left: 2px;
    right: 2px;
    top: 2px;
    bottom: 2px;
}

.cb-tile--thumb > .cb-tile__name {
    font-size: var(--cb-font-xs);
    max-height: 30px;
    overflow: hidden;
}

.cb-tile--thumb > .cb-tile__sub {
    margin-top: 1px;
    color: var(--cb-text-secondary);
}

.cb-tile--thumb > .cb-bar {
    width: 72px;
    margin-top: 4px;
}

/* Gruppen-Reiter über den Kacheln (Versorgung: Strom erzeugen | Strom verteilen | Wasser | Abwasser | Werkzeuge …) */
.cb-group-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    align-self: flex-start;
    padding-left: 3px;
    padding-right: 3px;
    padding-top: 3px;
    padding-bottom: 3px;
    margin-left: 4px;
    margin-bottom: 4px;
    border-radius: var(--cb-radius-button);
    background-color: var(--cb-surface-2);
}

.cb-group-tab {
    flex-direction: row;
    align-items: center;
    height: 28px;
    padding-left: 10px;
    padding-right: 8px;
    margin-left: 1px;
    margin-right: 1px;
    border-radius: 6px;
    color: var(--cb-text-muted);
    transition-property: background-color, color;
    transition-duration: 0.12s;
}

.cb-group-tab:hover {
    color: var(--cb-text);
}

.cb-group-tab.cb-on {
    background-color: var(--cb-card);
    color: var(--cb-text);
}

.cb-group-tab__label {
    margin-left: 6px;
    font-size: var(--cb-font-s);
    -unity-font-style: bold;
}

.cb-group-tab__count {
    margin-left: 6px;
    min-width: 16px;
    padding-left: 4px;
    padding-right: 4px;
    border-radius: 8px;
    font-size: var(--cb-font-xs);
    -unity-text-align: middle-center;
    color: var(--cb-text-muted);
    background-color: var(--cb-border-soft);
}

/* Reiter, in dem das aktive Werkzeug liegt */
.cb-group-tab--active > .cb-group-tab__count {
    background-color: var(--cb-action);
    color: var(--cb-on-action);
}

.cb-group-body {
    min-height: 132px;
}

/* Balken (Nachfrage in Zonen-Kacheln) */
.cb-bar {
    width: 84px;
    height: 6px;
    margin-top: 5px;
    border-radius: 3px;
    background-color: var(--cb-border-soft);
}

.cb-bar__fill {
    height: 6px;
    border-radius: 3px;
    background-color: var(--cb-accent);
}

.cb-info {
    font-size: var(--cb-font-s);
    color: var(--cb-text-muted);
    white-space: normal;
    margin-top: 6px;
    padding-left: 4px;
    padding-right: 4px;
}

.cb-info-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 6px;
    padding-left: 4px;
}

.cb-info-row > Label {
    font-size: var(--cb-font-s);
    margin-right: 14px;
}

/* Kategorie-Leiste */
.cb-catbar {
    flex-direction: row;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: var(--cb-panel-strong);
}

.cb-cat {
    width: 92px;
    height: 58px;
    margin-left: 2px;
    margin-right: 2px;
    border-radius: var(--cb-radius-card);
    align-items: center;
    justify-content: center;
    color: var(--cb-text-secondary);
    transition-property: background-color, color;
    transition-duration: 0.12s;
}

.cb-cat:hover {
    background-color: var(--cb-card);
}

.cb-cat.cb-on {
    background-color: var(--cb-action);
    color: var(--cb-on-action);
}

.cb-cat__label {
    font-size: var(--cb-font-xs);
    -unity-font-style: bold;
    margin-top: 4px;
    -unity-text-align: middle-center;
}

.cb-cat--danger.cb-on {
    background-color: var(--cb-warn);
    color: var(--cb-on-accent);
}

/* Schieberegler (Weiche Kante im Gelände-Werkzeug) */
.cb-slider {
    width: 140px;
    margin-left: 4px;
    margin-right: 4px;
}

.cb-slider .unity-base-slider__tracker {
    background-color: var(--cb-surface-2);
    border-color: var(--cb-border);
}

.cb-slider .unity-base-slider__dragger {
    background-color: var(--cb-action);
    border-color: var(--cb-action);
}

/* ------------------------------------------------------------ Meldungen (Toasts) oben rechts */

.cb-toasts {
    position: absolute;
    top: 92px;
    right: 16px;
    width: 340px;
}

.cb-toast {
    flex-direction: row;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 12px;
    padding-bottom: 12px;
    margin-bottom: 8px;
    background-color: var(--cb-surface);
    border-width: 1px;
    border-color: var(--cb-border);
    border-radius: var(--cb-radius-card);
    opacity: 1;
    transition-property: opacity, translate;
    transition-duration: 0.25s;
}

.cb-toast--enter {
    opacity: 0;
    translate: 24px 0;
}

.cb-toast--leave {
    opacity: 0;
}

.cb-toast--warning {
    border-color: var(--cb-warn-border);
}

.cb-toast__badge {
    width: 34px;
    height: 34px;
    border-radius: var(--cb-radius-card);
    background-color: var(--cb-card);
    color: var(--cb-action);
    align-items: center;
    justify-content: center;
    margin-right: 12px;
    flex-shrink: 0;
}

.cb-toast--warning .cb-toast__badge {
    background-color: #4A3220;
    color: var(--cb-warn);
}

.cb-toast__body {
    flex-shrink: 1;
    flex-grow: 1;
}

.cb-toast__title {
    font-size: 14px;
    -unity-font-style: bold;
    white-space: normal;
}

.cb-toast__text {
    font-size: var(--cb-font-s);
    color: var(--cb-text-muted);
    white-space: normal;
    margin-top: 2px;
}

/* ------------------------------------------------------------ Tooltip */

.cb-tooltip {
    position: absolute;
    max-width: 360px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: var(--cb-surface-2);
    border-width: 1px;
    border-color: var(--cb-border);
    border-radius: var(--cb-radius-button);
    font-size: var(--cb-font-s);
    white-space: normal;
}

/* =====================================================================================================
   Fenster (Phase 2) – Baukasten UI/Panels (Ui, GameWindow, WindowHost). Nur sichere UI-Toolkit-Eigenschaften:
   kein gap/grid/box-shadow/:first-child – Abstände über margin, Raster über flex-wrap + Zellen mit Prozentbreite.
   ===================================================================================================== */

:root {
    --cb-info-surface: #1E2C3D;
    --cb-info-text: #93C1F0;
    --cb-bad-surface: #3D2224;
    --cb-bad-text: #FF8A80;
    --cb-accent-surface: #3A3020;
    --cb-quote: #23262E;
    --cb-line: #2C3039;
}

.cb-disabled {
    opacity: 0.4;
}

/* ------------------------------------------------------------ Rahmen */

.cb-window {
    flex-direction: column;
    overflow: hidden;
    background-color: var(--cb-panel-strong);
    border-width: 1px;
    border-color: var(--cb-border);
    border-radius: var(--cb-radius-panel);
}

.cb-window--right {
    position: absolute;
    right: 16px;
    top: 92px;
    bottom: 16px;
    width: 392px;
}

.cb-center-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 92px;
    bottom: 16px;
    align-items: center;
}

.cb-window--center {
    width: 500px;
    max-height: 100%;
    flex-shrink: 1;
}

.cb-window__head {
    flex-shrink: 0;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 14px;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-color: var(--cb-border-soft);
}

.cb-window__scroll {
    flex-grow: 1;
    flex-shrink: 1;
}

.cb-window__content {
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 16px;
}

/* Scrollleiste schmal und dunkel (Klassen des Unity-Scrollers) */
.cb-window__scroll .unity-scroller--vertical {
    width: 8px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.cb-window__scroll .unity-scroller--vertical .unity-repeat-button {
    display: none;
}

.cb-window__scroll .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.cb-window__scroll .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: var(--cb-border);
    border-width: 0;
    border-radius: 4px;
    width: 6px;
}

/* ------------------------------------------------------------ Kopf */

.cb-head-bar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.cb-head-btn {
    width: 32px;
    height: 32px;
    margin-left: 4px;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--cb-border);
    background-color: var(--cb-card);
    color: var(--cb-text-secondary);
    align-items: center;
    justify-content: center;
    transition-property: background-color, color;
    transition-duration: 0.12s;
}

.cb-head-btn:hover {
    background-color: var(--cb-card-hover);
    color: var(--cb-text);
}

.cb-head-btn.cb-on {
    background-color: var(--cb-accent);
    border-color: var(--cb-accent);
    color: var(--cb-on-accent);
}

.cb-title-row {
    flex-direction: row;
    align-items: center;
}

.cb-title-block {
    flex-grow: 1;
    flex-shrink: 1;
}

.cb-title {
    font-size: 22px;
    white-space: normal;
}

.cb-subtitle {
    font-size: var(--cb-font-m);
    color: var(--cb-text-muted);
    margin-top: 2px;
    white-space: normal;
}

.cb-window__head .cb-chips {
    margin-top: 8px;
}

/* Reiter */
.cb-tabs {
    flex-direction: row;
    margin-top: 12px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-radius: var(--cb-radius-button);
    background-color: var(--cb-surface-2);
}

.cb-tab {
    flex-grow: 1;
    flex-basis: 0;
    height: 34px;
    margin-left: 2px;
    margin-right: 2px;
    border-radius: 8px;
    align-items: center;
    justify-content: center;
    color: var(--cb-text-muted);
    transition-property: background-color, color;
    transition-duration: 0.12s;
}

.cb-tab:hover {
    color: var(--cb-text);
}

.cb-tab.cb-on {
    background-color: var(--cb-card);
    color: var(--cb-text);
}

.cb-tab__text {
    font-size: var(--cb-font-m);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.cb-tabs--small .cb-tab {
    height: 28px;
}

.cb-tabs--small .cb-tab__text {
    font-size: var(--cb-font-s);
}

/* ------------------------------------------------------------ Text, Abschnitte */

.cb-space {
    flex-shrink: 0;
}

.cb-divider {
    height: 1px;
    margin-top: 6px;
    margin-bottom: 6px;
    background-color: #3A3F4C;
}

.cb-section {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 14px;
    margin-bottom: 8px;
}

.cb-section__title {
    font-size: var(--cb-font-l);
    flex-shrink: 0;
}

.cb-section__hint {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 10px;
    font-size: var(--cb-font-s);
    color: var(--cb-text-muted);
    -unity-text-align: lower-right;
}

.cb-text {
    font-size: var(--cb-font-m);
    white-space: normal;
    margin-bottom: 6px;
}

.cb-note {
    font-size: var(--cb-font-s);
    color: var(--cb-text-muted);
    white-space: normal;
    margin-top: 2px;
    margin-bottom: 8px;
}

/* Textfarben je Ton */
.cb-fg--good { color: var(--cb-action); }
.cb-fg--warn { color: var(--cb-warn-text); }
.cb-fg--bad { color: var(--cb-bad-text); }
.cb-fg--info { color: var(--cb-info-text); }
.cb-fg--accent { color: var(--cb-accent); }
.cb-fg--muted { color: var(--cb-text-muted); }

/* ------------------------------------------------------------ Karten und Zeilen */

.cb-card {
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 12px;
    padding-bottom: 6px;
    margin-bottom: 10px;
    border-radius: var(--cb-radius-card);
    border-width: 1px;
    border-color: var(--cb-border-soft);
    background-color: var(--cb-card);
}

.cb-fields {
    padding-top: 2px;
    padding-bottom: 2px;
}

.cb-field {
    flex-direction: row;
    align-items: center;
    min-height: 38px;
    padding-top: 6px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-color: var(--cb-line);
}

.cb-field.cb-last {
    border-bottom-width: 0;
}

.cb-field__label {
    width: 40%;
    flex-shrink: 0;
    font-size: var(--cb-font-m);
    color: var(--cb-text-secondary);
    white-space: normal;
}

.cb-field__value {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 10px;
    font-size: var(--cb-font-m);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    white-space: normal;
}

.cb-field--link {
    border-radius: 6px;
}

.cb-field--link:hover {
    background-color: var(--cb-card-hover);
}

.cb-field--link > .cb-field__value {
    color: var(--cb-action);
}

.cb-field--link:hover > .cb-field__value {
    color: var(--cb-action-hover);
}

.cb-field__chevron {
    margin-left: 6px;
    font-size: var(--cb-font-l);
    color: var(--cb-text-muted);
}

.cb-field--total > .cb-field__label,
.cb-field--total > .cb-field__value {
    font-size: 14px;
    -unity-font-style: bold;
}

/* Tabelle (Wochenbilanz) */
.cb-cols {
    flex-direction: row;
    align-items: center;
    min-height: 26px;
}

.cb-cols__label {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: var(--cb-font-m);
    white-space: normal;
}

.cb-cols__cell {
    width: 112px;
    flex-shrink: 0;
    font-size: var(--cb-font-m);
    -unity-text-align: middle-right;
}

.cb-cols--header > Label {
    -unity-font-style: bold;
}

.cb-cols--header > .cb-cols__label {
    color: var(--cb-text-muted);
}

/* ------------------------------------------------------------ Raster, Kennzahl-Kacheln */

.cb-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-left: -4px;
    margin-right: -4px;
    margin-bottom: 6px;
}

.cb-cell {
    padding-left: 4px;
    padding-right: 4px;
    padding-bottom: 8px;
}

.cb-grid--2 > .cb-cell {
    width: 50%;
}

.cb-grid--3 > .cb-cell {
    width: 33.33%;
}

.cb-cell--need {
    padding-left: 4px;
    padding-right: 12px;
}

.cb-stat-tile {
    flex-grow: 1;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-radius: var(--cb-radius-card);
    border-width: 1px;
    border-color: var(--cb-border-soft);
    background-color: var(--cb-card);
}

.cb-stat-tile__label {
    font-size: var(--cb-font-s);
    color: var(--cb-text-muted);
}

.cb-stat-tile__row {
    flex-direction: row;
    align-items: flex-end;
    flex-wrap: wrap;
    margin-top: 2px;
}

.cb-stat-tile__value {
    font-size: 20px;
    -unity-font-style: bold;
}

.cb-grid--3 .cb-stat-tile__value {
    font-size: 16px;
}

.cb-stat-tile__unit {
    font-size: var(--cb-font-s);
    color: var(--cb-text-muted);
    margin-left: 4px;
    margin-bottom: 2px;
}

/* ------------------------------------------------------------ Balken */

.cb-progress-block {
    margin-bottom: 8px;
}

.cb-progress__caps {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 6px;
}

.cb-progress__cap {
    font-size: var(--cb-font-s);
    color: var(--cb-text-muted);
}

.cb-progress {
    height: 8px;
    border-radius: 4px;
    background-color: var(--cb-border-soft);
    overflow: hidden;
}

.cb-progress--thin {
    height: 6px;
    border-radius: 3px;
}

.cb-progress__fill {
    height: 100%;
    width: 0;
    border-radius: 4px;
    background-color: var(--cb-action);
}

.cb-fill--good { background-color: var(--cb-action); }
.cb-fill--warn { background-color: var(--cb-warn); }
.cb-fill--bad { background-color: #E06A5A; }
.cb-fill--info { background-color: var(--cb-zone-commercial); }
.cb-fill--accent { background-color: var(--cb-accent); }
.cb-fill--muted { background-color: var(--cb-text-muted); }

.cb-meter {
    margin-bottom: 10px;
}

.cb-meter__head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.cb-meter__label {
    flex-shrink: 0;
    font-size: var(--cb-font-m);
    -unity-font-style: bold;
}

.cb-meter__value {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 10px;
    font-size: var(--cb-font-m);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    white-space: normal;
}

.cb-need__head {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 4px;
}

.cb-need__label {
    font-size: var(--cb-font-s);
}

.cb-need__value {
    font-size: var(--cb-font-s);
    color: var(--cb-text-muted);
}

/* Mengenbalken (Altersgruppen, Bildung) */
.cb-vbar {
    flex-direction: row;
    align-items: center;
    height: 22px;
}

.cb-vbar__label {
    width: 72px;
    flex-shrink: 0;
    font-size: var(--cb-font-s);
    color: var(--cb-text-secondary);
}

.cb-vbar__track {
    flex-grow: 1;
    height: 8px;
    border-radius: 4px;
    background-color: var(--cb-border-soft);
    overflow: hidden;
}

.cb-vbar__fill {
    height: 100%;
    width: 0;
    border-radius: 4px;
}

.cb-vbar__value {
    width: 52px;
    flex-shrink: 0;
    font-size: var(--cb-font-s);
    -unity-text-align: middle-right;
}

/* Mini-Balkendiagramm (Wochen) */
.cb-chart {
    height: 110px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    margin-bottom: 10px;
    border-radius: var(--cb-radius-card);
    background-color: var(--cb-surface-2);
}

.cb-chart__caption {
    font-size: var(--cb-font-xs);
    color: var(--cb-text-muted);
    margin-bottom: 4px;
}

.cb-chart__bars {
    flex-grow: 1;
    flex-direction: row;
}

.cb-chart__col {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 2px;
    margin-right: 2px;
}

.cb-chart__half {
    flex-grow: 1;
    flex-basis: 0;
}

.cb-chart__half--up {
    justify-content: flex-end;
}

.cb-chart__half--down {
    justify-content: flex-start;
    border-top-width: 1px;
    border-color: var(--cb-border);
}

.cb-chart__bar {
    width: 100%;
    height: 0;
    border-radius: 2px;
}

.cb-chart__bar--pos { background-color: var(--cb-action); }
.cb-chart__bar--neg { background-color: var(--cb-warn); }

/* ------------------------------------------------------------ Chips (Pillen) */

.cb-chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 4px;
}

.cb-pill {
    flex-direction: row;
    align-items: center;
    height: 24px;
    padding-left: 9px;
    padding-right: 9px;
    margin-right: 6px;
    margin-bottom: 6px;
    border-radius: 10px;
    font-size: var(--cb-font-s);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.cb-head-bar > .cb-pill {
    margin-bottom: 0;
    border-radius: 8px;
}

.cb-pill__dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 6px;
}

.cb-pill__text {
    font-size: var(--cb-font-s);
    -unity-font-style: bold;
}

/* Flächenfarben je Ton (Chips, Karten, Meldungen) */
.cb-tone--good { background-color: var(--cb-ok-surface); color: var(--cb-ok-text); }
.cb-tone--warn { background-color: var(--cb-warn-surface); color: var(--cb-warn-text); }
.cb-tone--bad { background-color: var(--cb-bad-surface); color: var(--cb-bad-text); }
.cb-tone--info { background-color: var(--cb-info-surface); color: var(--cb-info-text); }
.cb-tone--accent { background-color: var(--cb-accent-surface); color: var(--cb-accent); }
.cb-tone--muted { background-color: var(--cb-surface-2); color: var(--cb-text); }

/* ------------------------------------------------------------ Listenzeile mit Avatar */

.cb-list-item {
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 9px;
    padding-bottom: 9px;
    margin-bottom: 6px;
    border-radius: var(--cb-radius-card);
    border-width: 1px;
    border-color: var(--cb-border-soft);
    background-color: var(--cb-card);
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.cb-list-item:hover {
    background-color: var(--cb-card-hover);
    border-color: var(--cb-border);
}

.cb-list-item--static:hover {
    background-color: var(--cb-card);
    border-color: var(--cb-border-soft);
}

.cb-avatar {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border-radius: 8px;
    align-items: center;
    justify-content: center;
}

.cb-avatar--l {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    margin-right: 12px;
}

.cb-avatar__text {
    font-size: 14px;
    color: var(--cb-text);
}

.cb-avatar--l > .cb-avatar__text {
    font-size: 19px;
}

.cb-list-item__body {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 12px;
    margin-right: 8px;
}

.cb-list-item__title {
    font-size: 14px;
    -unity-font-style: bold;
}

.cb-list-item__sub {
    font-size: var(--cb-font-s);
    color: var(--cb-text-muted);
    white-space: normal;
}

.cb-list-item__badge {
    flex-shrink: 0;
    margin-right: 0;
    margin-bottom: 0;
}

/* ------------------------------------------------------------ Zitat, Meldung */

.cb-quote {
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    margin-bottom: 8px;
    border-radius: var(--cb-radius-card);
    background-color: var(--cb-quote);
}

.cb-quote__caption {
    font-size: var(--cb-font-s);
    -unity-font-style: bold;
    color: var(--cb-text-muted);
    margin-bottom: 4px;
}

.cb-quote__text {
    font-size: var(--cb-font-m);
    white-space: normal;
}

.cb-message {
    flex-direction: row;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    margin-bottom: 10px;
    border-radius: var(--cb-radius-card);
    border-width: 1px;
    border-color: var(--cb-border-soft);
    background-color: var(--cb-card);
    color: var(--cb-text);
}

.cb-message__stripe {
    width: 6px;
    flex-shrink: 0;
    border-radius: 3px;
    margin-right: 10px;
    background-color: var(--cb-zone-commercial);
}

.cb-message__body {
    flex-grow: 1;
    flex-shrink: 1;
}

.cb-message__title {
    font-size: var(--cb-font-m);
    -unity-font-style: bold;
    color: var(--cb-text);
    white-space: normal;
}

.cb-message__text {
    font-size: var(--cb-font-s);
    color: var(--cb-text-muted);
    white-space: normal;
    margin-top: 2px;
}

/* Meldung: Fläche neutral, nur Streifen/Rand im Ton (überschreibt .cb-tone--…) */
.cb-message.cb-tone--good,
.cb-message.cb-tone--info,
.cb-message.cb-tone--accent,
.cb-message.cb-tone--muted {
    background-color: var(--cb-card);
}

.cb-message.cb-tone--warn {
    background-color: var(--cb-warn-surface);
    border-color: var(--cb-warn-border);
}

.cb-message.cb-tone--bad {
    background-color: var(--cb-bad-surface);
    border-color: #6B3030;
}

.cb-tone--good > .cb-message__stripe { background-color: var(--cb-zone-residential); }
.cb-tone--warn > .cb-message__stripe { background-color: var(--cb-warn); }
.cb-tone--bad > .cb-message__stripe { background-color: #E06A5A; }
.cb-tone--accent > .cb-message__stripe { background-color: var(--cb-accent); }
.cb-tone--muted > .cb-message__stripe { background-color: var(--cb-text-muted); }

/* ------------------------------------------------------------ Aktionsknöpfe, Stepper, Regler, Blättern */

.cb-actions {
    flex-direction: row;
    margin-left: -4px;
    margin-right: -4px;
    margin-top: 4px;
    margin-bottom: 8px;
}

.cb-action {
    flex-grow: 1;
    flex-basis: 0;
    height: 40px;
    margin-left: 4px;
    margin-right: 4px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: var(--cb-radius-button);
    border-width: 1px;
    border-color: var(--cb-border);
    background-color: var(--cb-card);
    color: var(--cb-text);
    align-items: center;
    justify-content: center;
    transition-property: background-color, border-color, color;
    transition-duration: 0.12s;
}

.cb-action:hover {
    background-color: var(--cb-card-hover);
}

.cb-action.cb-on {
    border-color: var(--cb-action);
    color: var(--cb-action);
}

.cb-action--primary {
    background-color: var(--cb-action);
    border-color: var(--cb-action);
    color: var(--cb-on-action);
}

.cb-action--primary:hover {
    background-color: var(--cb-action-hover);
}

.cb-action--danger {
    background-color: var(--cb-warn-surface);
    border-color: var(--cb-warn-border);
    color: var(--cb-warn-text);
}

.cb-action--danger:hover {
    border-color: var(--cb-warn);
    background-color: var(--cb-warn-surface);
}

.cb-action__text {
    font-size: var(--cb-font-m);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.cb-step-btn {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--cb-border);
    background-color: var(--cb-surface-2);
    align-items: center;
    justify-content: center;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.cb-step-btn:hover {
    background-color: var(--cb-card-hover);
}

.cb-step-btn__text {
    font-size: var(--cb-font-l);
    -unity-font-style: bold;
}

.cb-stepper > .cb-field__label {
    width: auto;
    flex-grow: 1;
    flex-shrink: 1;
}

.cb-stepper__value {
    min-width: 52px;
    font-size: var(--cb-font-m);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.cb-stepper__extra {
    width: 104px;
    flex-shrink: 0;
    margin-left: 8px;
    font-size: var(--cb-font-s);
    -unity-text-align: middle-right;
}

.cb-slider-row > .cb-slider {
    flex-grow: 1;
    width: auto;
}

.cb-pager {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
}

.cb-pager__text {
    min-width: 110px;
    font-size: var(--cb-font-s);
    color: var(--cb-text-muted);
    -unity-text-align: middle-center;
}

/* ------------------------------------------------------------ Welt-Beschriftungen */

.cb-world-labels {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.cb-world-label {
    position: absolute;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--cb-border);
    background-color: rgba(20, 22, 27, 0.88);
    color: var(--cb-text);
    font-size: var(--cb-font-m);
    -unity-font-style: bold;
    white-space: nowrap;
}

.cb-world-label--error {
    color: var(--cb-bad-text);
    border-color: #6B3030;
}

.cb-world-label--letter {
    width: 28px;
    height: 26px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    -unity-text-align: middle-center;
    font-size: 14px;
    background-color: var(--cb-action);
    border-color: var(--cb-action);
    color: var(--cb-on-action);
}

/* ------------------------------------------------------------ Welt (Etappe 5): Weltkarte, Rohstoff-Untermenü */

.cb-window--wide {
    width: 780px;
}

.cb-image {
    border-radius: 8px;
    margin-bottom: 8px;
    align-self: center;
    flex-shrink: 0;
}

.cb-flyout {
    position: absolute;
    left: 84px;
    top: 136px;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 6px;
    padding-top: 4px;
    padding-bottom: 4px;
}

/* ---------------------------------------------------------------------------------------------------------------
   Speichern & Laden – Texteingabe im Baukasten (Ui.TextInput)
   --------------------------------------------------------------------------------------------------------------- */
.cb-text-row {
    align-items: center;
}

.cb-text-input {
    flex-grow: 1;
    margin-left: 8px;
    margin-right: 0;
    min-width: 120px;
}

/* Unity-Standardfeld ist hell – dunkel wie die übrigen Flächen, sonst helle Schrift auf hellem Grund */
.cb-text-input > .unity-base-text-field__input {
    min-height: 32px;
    padding-left: 10px;
    padding-right: 10px;
    border-width: 1px;
    border-radius: var(--cb-radius-button);
    border-color: var(--cb-border);
    background-color: var(--cb-surface-2);
    color: var(--cb-text);
    font-size: var(--cb-font-m);
    --unity-cursor-color: var(--cb-text);
    --unity-selection-color: rgba(43, 179, 163, 0.45);
    transition-property: border-color, background-color;
    transition-duration: 0.12s;
}

.cb-text-input:hover > .unity-base-text-field__input {
    border-color: var(--cb-text-muted);
}

.cb-text-input:focus > .unity-base-text-field__input {
    border-color: var(--cb-action);
    background-color: #101216;
}

.cb-text-input .unity-text-element {
    color: var(--cb-text);
}

.cb-text-input--large {
    margin-left: 0;
}

.cb-text-input--large > .unity-base-text-field__input {
    min-height: 52px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: var(--cb-radius-card);
    font-size: 22px;
    -unity-font-style: bold;
}

.cb-big-input {
    margin-top: 4px;
    margin-bottom: 10px;
}

/* ------------------------------------------------------------ Assistent (Neues-Spiel-Fenster): Schritte, Begrüßung, Gruppen, Auswahlkarten */

.cb-steps {
    flex-direction: row;
    align-items: center;
    margin-top: 14px;
}

.cb-step {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
    padding-left: 4px;
    padding-right: 6px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-radius: var(--cb-radius-button);
    transition-property: background-color;
    transition-duration: 0.12s;
}

.cb-step:hover {
    background-color: var(--cb-card);
}

.cb-step.cb-disabled {
    opacity: 0.45;
}

.cb-step.cb-disabled:hover {
    background-color: rgba(0, 0, 0, 0);
}

.cb-step__dot {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    border-radius: 14px;
    border-width: 2px;
    border-color: var(--cb-border);
    background-color: var(--cb-surface-2);
    align-items: center;
    justify-content: center;
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
}

.cb-step__num {
    font-size: var(--cb-font-m);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--cb-text-muted);
}

.cb-step.cb-on > .cb-step__dot {
    border-color: var(--cb-accent);
    background-color: var(--cb-accent);
}

.cb-step.cb-on .cb-step__num {
    color: var(--cb-on-accent);
}

.cb-step--done > .cb-step__dot {
    border-color: var(--cb-action);
    background-color: var(--cb-ok-surface);
}

.cb-step--done .cb-step__num {
    color: var(--cb-action);
}

.cb-step__text {
    margin-left: 8px;
    flex-shrink: 1;
}

.cb-step__title {
    font-size: var(--cb-font-m);
    -unity-font-style: bold;
    color: var(--cb-text-secondary);
}

.cb-step.cb-on .cb-step__title {
    color: var(--cb-text);
}

.cb-step__hint {
    font-size: var(--cb-font-xs);
    color: var(--cb-text-muted);
}

.cb-steps__line {
    flex-grow: 1;
    min-width: 12px;
    height: 2px;
    margin-left: 4px;
    margin-right: 4px;
    border-radius: 1px;
    background-color: var(--cb-border);
}

.cb-steps__line--done {
    background-color: var(--cb-action);
}

.cb-hero {
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 16px;
    padding-bottom: 16px;
    margin-bottom: 12px;
    border-radius: var(--cb-radius-card);
    border-width: 1px;
    border-left-width: 4px;
    border-color: var(--cb-warn-border);
    border-left-color: var(--cb-accent);
    background-color: var(--cb-accent-surface);
}

.cb-hero__kicker {
    font-size: var(--cb-font-xs);
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--cb-accent);
    margin-bottom: 4px;
}

.cb-hero__title {
    font-size: 24px;
    -unity-font-style: bold;
    white-space: normal;
}

.cb-hero__text {
    margin-top: 6px;
    font-size: 14px;
    color: var(--cb-text-secondary);
    white-space: normal;
}

.cb-group {
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 12px;
    padding-bottom: 8px;
    margin-bottom: 10px;
    border-radius: var(--cb-radius-card);
    border-width: 1px;
    border-color: var(--cb-border-soft);
    background-color: var(--cb-surface);
}

.cb-group__head {
    flex-direction: row;
    align-items: center;
}

.cb-group__title {
    font-size: var(--cb-font-l);
    -unity-font-style: bold;
    flex-shrink: 0;
}

.cb-group__hint {
    flex-grow: 1;
    margin-left: 10px;
    font-size: var(--cb-font-xs);
    color: var(--cb-text-muted);
    -unity-text-align: middle-right;
}

.cb-group__desc {
    margin-top: 2px;
    margin-bottom: 8px;
    font-size: var(--cb-font-s);
    color: var(--cb-text-muted);
    white-space: normal;
}

.cb-option-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-left: -4px;
    margin-right: -4px;
}

.cb-option-cell {
    width: 33.333%;
    padding-left: 4px;
    padding-right: 4px;
    padding-bottom: 8px;
}

.cb-option {
    flex-grow: 1;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 9px;
    padding-bottom: 9px;
    border-radius: var(--cb-radius-button);
    border-width: 1px;
    border-color: var(--cb-border);
    background-color: var(--cb-card);
    transition-property: background-color, border-color, opacity;
    transition-duration: 0.12s;
}

.cb-option:hover {
    background-color: var(--cb-card-hover);
    border-color: var(--cb-text-muted);
}

.cb-option.cb-on {
    border-color: var(--cb-action);
    background-color: #1C3431;
}

.cb-option--rare {
    border-color: var(--cb-accent);
}

.cb-option.cb-disabled {
    opacity: 0.35;
}

.cb-option.cb-disabled:hover {
    background-color: var(--cb-card);
    border-color: var(--cb-border);
}

.cb-option__head {
    flex-direction: row;
    align-items: center;
}

.cb-option__check {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    margin-right: 8px;
    border-radius: 7px;
    border-width: 2px;
    border-color: var(--cb-text-muted);
}

.cb-option.cb-on .cb-option__check {
    border-color: var(--cb-action);
    background-color: var(--cb-action);
}

.cb-option__title {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: var(--cb-font-m);
    -unity-font-style: bold;
    white-space: normal;
}

.cb-option__badge {
    flex-shrink: 0;
    margin-left: 6px;
    font-size: var(--cb-font-xs);
    color: var(--cb-text-muted);
}

.cb-option--rare .cb-option__badge {
    color: var(--cb-accent);
}

.cb-option.cb-on .cb-option__badge {
    color: var(--cb-action);
}

.cb-option__text {
    margin-top: 4px;
    font-size: var(--cb-font-xs);
    color: var(--cb-text-muted);
    white-space: normal;
}

/* Breiterer Assistent: Karte groß, drei Spalten Auswahl */
.cb-window--wizard {
    width: 880px;
}

/* ------------------------------------------------------------ Spielstart: Neues-Spiel-Fenster (Auswahl-Chips, Schritte) */

.cb-choice {
    height: 28px;
    padding-left: 11px;
    padding-right: 11px;
    border-width: 1px;
    border-color: var(--cb-border);
    background-color: var(--cb-surface-2);
    color: var(--cb-text);
    transition-property: background-color, border-color, color, opacity;
    transition-duration: 0.12s;
}

.cb-choice:hover {
    background-color: var(--cb-card-hover);
}

.cb-choice.cb-on {
    background-color: var(--cb-action);
    border-color: var(--cb-action);
    color: var(--cb-on-action);
}

.cb-choice--rare {
    border-color: var(--cb-accent);
}

.cb-choice.cb-disabled {
    opacity: 0.35;
}

.cb-choice__badge {
    margin-left: 6px;
    font-size: var(--cb-font-xs);
    color: var(--cb-text-muted);
}

.cb-choice.cb-on .cb-choice__badge {
    color: var(--cb-on-action);
}

.cb-choice--rare .cb-choice__badge {
    color: var(--cb-accent);
}

/* --- Setzen statt Zonen: Nachfrage-Anzeige in der oberen Leiste (W L B I, senkrechte Balken) --- */
.cb-demand {
    flex-direction: row;
    align-items: flex-end;
    margin-left: 6px;
}

.cb-demand__item {
    flex-direction: column;
    align-items: center;
    width: 16px;
    margin-left: 2px;
    margin-right: 2px;
}

.cb-demand__bar {
    width: 8px;
    height: 22px;
    border-radius: 3px;
    background-color: var(--cb-border-soft);
    justify-content: flex-end;
}

.cb-demand__fill {
    width: 8px;
    border-radius: 3px;
    background-color: var(--cb-accent);
}

.cb-demand__label {
    font-size: var(--cb-font-xs);
    color: var(--cb-text-muted);
    margin-top: 1px;
}
